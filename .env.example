# Keep PostgreSQL private. Use an SSH tunnel to the Azure VM for local development.
# Replace the credentials with the local database user and password you created.
DATABASE_URL="postgresql://visitor_app:REPLACE_ME@127.0.0.1:5432/visitor_system?schema=public"
SHADOW_DATABASE_URL="postgresql://visitor_app:REPLACE_ME@127.0.0.1:5432/visitor_system_shadow?schema=public"
# npm run dev creates a private SESSION_SECRET automatically if it is missing.
APP_URL="http://localhost:3000"
# Generated automatically on first app start; keep this key separate from database backups.
SETTINGS_ENCRYPTION_KEY=""
