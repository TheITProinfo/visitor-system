generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMINISTRATOR
  RECEPTIONIST
  EMPLOYEE
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum AiProvider {
  OPENAI
  AZURE_OPENAI
}

enum AiReportCadence {
  DAILY
  WEEKLY
}

enum AiReportDeliveryStatus {
  PROCESSING
  SENT
  FAILED
}

enum EntraLinkStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  role         UserRole
  status       UserStatus @default(INVITED)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  entraTenantId String?
  entraObjectId String?
  hostedVisits VisitRecord[] @relation("VisitHost")
  sentInvitations Invitation[] @relation("InvitationCreator")
  aiAuditEvents AiAuditEvent[]
  entraLinkRequests EntraLinkRequest[] @relation("EntraLinkRequestedFor")
  reviewedEntraLinks EntraLinkRequest[] @relation("EntraLinkReviewedBy")
  entraLinkChallenges EntraLinkChallenge[]
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  @@index([role, status])
  @@index([departmentId])
  @@unique([entraTenantId, entraObjectId])
}

model Invitation {
  id          String   @id @default(cuid())
  email       String   @unique
  role        UserRole
  tokenHash   String   @unique
  expiresAt   DateTime @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  createdById String
  createdBy   User     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt, acceptedAt])
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  users     User[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model VisitPurpose {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  visits    VisitRecord[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model CompanySettings {
  id                    String   @id @default(cuid())
  companyName           String
  address               String?
  timeZone              String   @default("UTC")
  logoFileKey           String?
  agreementText         String?  @db.Text
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean  @default(true)
  smtpUsername          String?
  smtpPasswordEncrypted String?  @db.Text
  smtpSenderName        String?
  smtpSenderEmail       String?
  printerEnabled        Boolean  @default(false)
  printerModel          String?
  printerAddress        String?
  badgeLabelWidthMm     Int?
  badgeLabelHeightMm    Int?
  aiProvider            AiProvider?
  aiEndpoint            String?
  aiModel               String?
  aiApiKeyEncrypted     String? @db.Text
  aiEnabled              Boolean @default(false)
  aiConnectionTestedAt  DateTime? @db.Timestamptz(3)
  aiConfigurationHash   String?
  aiTestedConfigurationHash String?
  aiPausedUntil         DateTime? @db.Timestamptz(3)
  aiRequestsPerUserPerDay Int @default(30)
  aiMaxTokensPerMonth    Int @default(100000)
  copilotEnabled         Boolean @default(false)
  copilotTenantId        String?
  copilotApiAudience     String?
  copilotConnectorClientId String?
  copilotLoginClientId String?
  copilotLoginClientSecretEncrypted String? @db.Text
  aiAuditEvents          AiAuditEvent[]
  aiReportSchedule      AiReportSchedule?
  entraLinkRequests     EntraLinkRequest[]
  entraLinkChallenges   EntraLinkChallenge[]
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
}

model AiAuditEvent {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  settingsId   String
  settings     CompanySettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  operation    String
  filters      Json?
  resultCount  Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  success      Boolean
  errorCode    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([settingsId, createdAt])
}

model AiReportSchedule {
  id                    String   @id @default(cuid())
  settingsId            String   @unique
  settings              CompanySettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  enabled               Boolean  @default(false)
  cadence               AiReportCadence @default(DAILY)
  sendTime              String   @default("09:00")
  recipientUserIds      String[] @default([])
  testedAt              DateTime? @db.Timestamptz(3)
  configurationHash     String?
  nextRunAt             DateTime? @db.Timestamptz(3)
  lastProcessedPeriodKey String?
  lastSentAt            DateTime? @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
}

model AiReportDelivery {
  id          String   @id @default(cuid())
  periodKey   String   @unique
  periodStart DateTime @db.Timestamptz(3)
  periodEnd   DateTime @db.Timestamptz(3)
  status      AiReportDeliveryStatus @default(PROCESSING)
  errorCode   String?
  sentAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

model EntraLinkChallenge {
  id        String   @id @default(cuid())
  stateHash String   @unique
  nonce     String
  codeVerifierEncrypted String @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  settingsId String
  settings   CompanySettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}

model EntraLinkRequest {
  id           String   @id @default(cuid())
  settingsId   String
  settings     CompanySettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("EntraLinkRequestedFor", fields: [userId], references: [id], onDelete: Cascade)
  entraTenantId String
  entraObjectId String
  email        String?
  displayName  String?
  status       EntraLinkStatus @default(PENDING)
  verifiedAt   DateTime @db.Timestamptz(3)
  reviewedById String?
  reviewedBy   User?    @relation("EntraLinkReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([userId, status])
  @@unique([entraTenantId, entraObjectId, status])
}

model VisitRecord {
  id                       String   @id @default(cuid())
  visitorProfileId         String?
  visitorProfile           VisitorProfile? @relation(fields: [visitorProfileId], references: [id], onDelete: SetNull)
  visitorFullName          String
  visitorCompanyName       String?
  isPersonalVisit          Boolean  @default(false)
  visitorEmail             String
  visitorPhone             String
  vehicleRegistrationNumber String?
  hostId                   String
  host                     User     @relation("VisitHost", fields: [hostId], references: [id], onDelete: Restrict)
  purposeId                String
  purpose                  VisitPurpose @relation(fields: [purposeId], references: [id], onDelete: Restrict)
  companyNameSnapshot      String
  hostNameSnapshot         String
  purposeNameSnapshot      String
  agreementTextSnapshot    String?  @db.Text
  signatureFileKey         String?
  photoFileKey             String?
  checkInToken             String?  @unique
  signedAt                 DateTime? @db.Timestamptz(3)
  checkedInAt              DateTime @default(now()) @db.Timestamptz(3)
  checkedOutAt             DateTime? @db.Timestamptz(3)

  @@index([visitorEmail, checkedInAt])
  @@index([hostId, checkedInAt])
  @@index([checkedInAt])
  @@index([visitorProfileId, checkedInAt])
}

model VisitorProfile {
  id           String        @id @default(cuid())
  fullName     String
  email        String?
  phoneNumber  String?
  company      String?
  vehiclePlate String?
  visitRecords VisitRecord[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  @@index([fullName])
  @@index([email])
}
